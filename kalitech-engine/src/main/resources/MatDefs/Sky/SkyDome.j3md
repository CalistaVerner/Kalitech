// FILE: MatDefs/Sky/SkyDome.j3md
MaterialDef SkyDome {
    MaterialParameters {
        Texture2D      SkyTexA
        Texture2D      SkyTexB
        TextureCubeMap SkyCubeA
        TextureCubeMap SkyCubeB
        Boolean        UseCube
        Float          SkyBlend

        Float TexBlend
        Float TexExposure

        Vector3 SunDir
        Vector3 MoonDir

        Color SunColor
        Float SunIntensity

        Color MoonColor
        Float MoonIntensity

        Color ZenithColor
        Color HorizonColor

        Float Haze
        Float SunDisk
        Float MoonDisk
        Float Exposure

        // ---- Clouds ----
        Boolean CloudsEnabled
        Float   Time
        Float   CloudsScale
        Vector2 CloudsSpeed
        Float   CloudsCoverage
        Float   CloudsSharpness
        Float   CloudsOpacity
        Float   CloudsHeightBlend
        Color   CloudsColor
        Float   CloudsLightPow
        Float   CloudsAmbient
    }

    Technique {
        VertexShader   GLSL330: MatDefs/Sky/SkyDome.vert
        FragmentShader GLSL330: MatDefs/Sky/SkyDome.frag

        WorldParameters {
            WorldMatrix
            ViewProjectionMatrix
            CameraPosition
        }
    }
}
