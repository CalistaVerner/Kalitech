MaterialDef SkyDome {
    MaterialParameters {
        // Textures (AAA crossfade: A/B + SkyBlend)
        Texture2D      SkyTexA
        Texture2D      SkyTexB
        TextureCubeMap SkyCubeA
        TextureCubeMap SkyCubeB
        Boolean        UseCube
        Float          SkyBlend

        Float TexBlend
        Float TexExposure

        Vector3 SunDir
        Vector3 MoonDir

        Color SunColor
        Float SunIntensity

        Color MoonColor
        Float MoonIntensity

        Color ZenithColor
        Color HorizonColor

        Float Haze
        Float SunDisk
        Float MoonDisk
        Float Exposure
    }

    Technique {
        VertexShader   GLSL150: MatDefs/Sky/SkyDome.vert
        FragmentShader GLSL150: MatDefs/Sky/SkyDome.frag

        WorldParameters {
            WorldMatrix
            ViewProjectionMatrix
            CameraPosition
        }
    }
}