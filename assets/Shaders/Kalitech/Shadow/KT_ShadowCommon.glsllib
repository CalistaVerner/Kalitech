// FILE: assets/Shaders/Kalitech/Shadow/KT_ShadowCommon.glsllib

#import "Shaders/Kalitech/Shadow/KT_ShadowUBO.glsllib"

int kt_chooseSplit(float viewSpaceDepth)
{
    int n = int(kt_shadowHeader.x);
    n = clamp(n, 1, KT_SHADOW_MAX_SPLITS);

    // viewSpaceDepth предполагается как положительная глубина вдоль -Z (см. ниже в вершиннике)
    for (int i = 0; i < n; i++) {
        float farZ = kt_shadowNearFar[i].y;
        if (viewSpaceDepth <= farZ) return i;
    }
    return n - 1;
}

vec4 kt_shadowCoord(int splitIndex, vec3 worldPos)
{
    vec4 lp = kt_shadowViewProj[splitIndex] * vec4(worldPos, 1.0);
    // NDC -> [0..1]
    lp.xyz = lp.xyz * 0.5 + 0.5;
    return lp;
}

float kt_shadowDepthCompare(vec4 shadowCoord, sampler2DShadow shadowMap)
{
    // sampler2DShadow expects vec3(uv, refDepth)
    return texture(shadowMap, vec3(shadowCoord.xy, shadowCoord.z));
}